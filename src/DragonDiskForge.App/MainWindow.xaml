<Window
    x:Class="DragonDiskForge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dragon DiskForge">

    <Grid x:Name="RootLayout"
          Background="{ThemeResource DragonBackgroundBrush}"
          Loaded="RootLayout_Loaded"
          SizeChanged="RootLayout_SizeChanged">
        <NavigationView x:Name="ShellNav"
                        Background="Transparent"
                        Foreground="{ThemeResource DragonTextBrush}"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="268">

            <NavigationView.PaneHeader>
                <Grid Margin="8,10,8,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="13"
                            Background="{StaticResource DragonEmberGradientBrush}">
                        <Viewbox Margin="9">
                            <Path Fill="White"
                                  Data="M 48,2 C 38,12 33,22 34,33 C 27,27 20,25 11,27 C 21,34 24,41 20,50 C 16,59 19,69 28,75 C 34,79 40,79 46,76 C 40,72 36,67 36,61 C 42,65 49,67 57,66 C 67,65 76,59 82,50 C 74,53 67,52 62,48 C 70,44 76,37 79,28 C 70,32 62,33 55,31 C 58,22 56,12 48,2 Z M 50,36 C 57,35 63,37 67,42 C 61,41 56,42 51,45 C 48,43 47,40 50,36 Z" />
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="DRAGON" FontSize="17" FontWeight="Bold" CharacterSpacing="90" />
                        <TextBlock Text="DISKFORGE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DragonEmberBrush}" CharacterSpacing="150" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Images" Tag="images">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mounted" Tag="mounted">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="MapDrive" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Explorer" Tag="explorer">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Convert" Tag="convert">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid x:Name="MainContentGrid"
                      Padding="30,24,30,34"
                      MaxWidth="1320"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="THE FORGE" FontSize="11" FontWeight="Bold"
                                       Foreground="{ThemeResource DragonEmberBrush}" CharacterSpacing="220" />
                            <TextBlock Text="Command your disk images"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="30" FontWeight="SemiBold"
                                       Foreground="{ThemeResource DragonTextBrush}" />
                        </StackPanel>
                        <Border x:Name="HeaderStatusPill"
                                Grid.Column="1"
                                Style="{StaticResource DragonStatusPillStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource DragonSuccessBrush}" />
                                <TextBlock Text="Core 0.1" FontWeight="SemiBold" />
                                <TextBlock Text="•" Foreground="{ThemeResource DragonMutedBrush}" />
                                <TextBlock Text="Ready" Foreground="{ThemeResource DragonMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="DropZone"
                            Grid.Row="1"
                            AllowDrop="True"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop"
                            Background="{StaticResource DragonHeroBrush}"
                            BorderBrush="{ThemeResource DragonBorderHotBrush}"
                            BorderThickness="1"
                            CornerRadius="26"
                            Padding="30"
                            MinHeight="330">
                        <Grid>
                            <Canvas Width="270" Height="150"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,22,16"
                                    Opacity="0.045"
                                    IsHitTestVisible="False">
                                <Path Fill="{ThemeResource DragonMoltenBrush}" Data="M 0,22 Q 28,0 56,22 Q 28,44 0,22 Z" />
                                <Path Canvas.Left="54" Fill="{ThemeResource DragonMoltenBrush}" Data="M 0,22 Q 28,0 56,22 Q 28,44 0,22 Z" />
                                <Path Canvas.Left="108" Fill="{ThemeResource DragonMoltenBrush}" Data="M 0,22 Q 28,0 56,22 Q 28,44 0,22 Z" />
                                <Path Canvas.Left="162" Fill="{ThemeResource DragonMoltenBrush}" Data="M 0,22 Q 28,0 56,22 Q 28,44 0,22 Z" />
                                <Path Canvas.Left="27" Canvas.Top="39" Fill="{ThemeResource DragonMoltenBrush}" Data="M 0,22 Q 28,0 56,22 Q 28,44 0,22 Z" />
                                <Path Canvas.Left="81" Canvas.Top="39" Fill="{ThemeResource DragonMoltenBrush}" Data="M 0,22 Q 28,0 56,22 Q 28,44 0,22 Z" />
                                <Path Canvas.Left="135" Canvas.Top="39" Fill="{ThemeResource DragonMoltenBrush}" Data="M 0,22 Q 28,0 56,22 Q 28,44 0,22 Z" />
                            </Canvas>

                            <Viewbox x:Name="HeroWatermark"
                                     Width="330" Height="300"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"
                                     Opacity="0.09"
                                     IsHitTestVisible="False">
                                <Path Fill="{ThemeResource DragonMoltenBrush}"
                                      Data="M 48,2 C 38,12 33,22 34,33 C 27,27 20,25 11,27 C 21,34 24,41 20,50 C 16,59 19,69 28,75 C 34,79 40,79 46,76 C 40,72 36,67 36,61 C 42,65 49,67 57,66 C 67,65 76,59 82,50 C 74,53 67,52 62,48 C 70,44 76,37 79,28 C 70,32 62,33 55,31 C 58,22 56,12 48,2 Z M 50,36 C 57,35 63,37 67,42 C 61,41 56,42 51,45 C 48,43 47,40 50,36 Z" />
                            </Viewbox>

                            <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="HeroCopyPanel"
                                            VerticalAlignment="Center"
                                            Spacing="13"
                                            Margin="8,4,30,4">
                                    <Border Width="58" Height="58" CornerRadius="18"
                                            Background="{ThemeResource DragonEmberSoftBrush}"
                                            BorderBrush="{ThemeResource DragonBorderHotBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left">
                                        <FontIcon Glyph="&#xE898;" FontSize="25"
                                                  Foreground="{ThemeResource DragonMoltenBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="DROP DISK IMAGE HERE"
                                               FontFamily="Segoe UI Variable Display"
                                               FontSize="29" FontWeight="Bold"
                                               CharacterSpacing="35"
                                               Foreground="{ThemeResource DragonTextBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Open, inspect and verify disk images in a safe read-only workflow. Mounting and Dragon Explorer are the next engine milestone."
                                               MaxWidth="650" FontSize="14"
                                               Foreground="{ThemeResource DragonMutedBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,7,0,0">
                                        <Button Content="Choose image"
                                                Click="OpenImage_Click"
                                                Style="{StaticResource DragonPrimaryButtonStyle}" />
                                        <Border x:Name="DragDropPill"
                                                Style="{StaticResource DragonStatusPillStyle}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Drag &amp; drop enabled"
                                                       Foreground="{ThemeResource DragonMutedBrush}" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Border x:Name="HeroInputPanel"
                                        Grid.Column="1"
                                        Margin="10,10,8,10"
                                        Padding="18"
                                        Background="{ThemeResource DragonSurfaceBrush}"
                                        BorderBrush="{ThemeResource DragonBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        VerticalAlignment="Center">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="FORGE INPUT" FontSize="11" FontWeight="Bold"
                                                   CharacterSpacing="180" Foreground="{ThemeResource DragonEmberBrush}" />
                                        <TextBlock Text="13+ image families" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="ISO  •  IMG  •  RAW  •  VHD(X)  •  VMDK  •  QCOW2  •  DMG  •  WIM  •  BIN/CUE  •  MDF/MDS  •  NRG  •  CCD"
                                                   Foreground="{ThemeResource DragonMutedBrush}"
                                                   TextWrapping="Wrap" LineHeight="23" />
                                        <Border Height="1" Background="{ThemeResource DragonBorderBrush}" Margin="0,3" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="SIGNATURE" FontSize="10" FontWeight="Bold"
                                                           Foreground="{ThemeResource DragonMutedBrush}" />
                                                <TextBlock Text="Detection engine" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="SAFETY" FontSize="10" FontWeight="Bold"
                                                           Foreground="{ThemeResource DragonMutedBrush}" />
                                                <TextBlock Text="Read-only first" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid x:Name="CapabilityGrid"
                          Grid.Row="2"
                          Margin="0,16,0,0"
                          ColumnSpacing="12"
                          RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="DetectCard"
                                Background="{ThemeResource DragonPanelStrongBrush}"
                                BorderBrush="{ThemeResource DragonBorderBrush}" BorderThickness="1"
                                CornerRadius="18" Padding="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12"
                                        Background="{ThemeResource DragonEmberSoftBrush}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                              Foreground="{ThemeResource DragonEmberBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Detect" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Extension + binary signatures"
                                               Foreground="{ThemeResource DragonMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="VerifyCard"
                                Grid.Column="1"
                                Background="{ThemeResource DragonPanelStrongBrush}"
                                BorderBrush="{ThemeResource DragonBorderBrush}" BorderThickness="1"
                                CornerRadius="18" Padding="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12"
                                        Background="{ThemeResource DragonEmberSoftBrush}">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="18"
                                              Foreground="{ThemeResource DragonMoltenBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Verify" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="SHA-256 integrity checks"
                                               Foreground="{ThemeResource DragonMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="MountCard"
                                Grid.Column="2"
                                Background="{ThemeResource DragonPanelStrongBrush}"
                                BorderBrush="{ThemeResource DragonBorderBrush}" BorderThickness="1"
                                CornerRadius="18" Padding="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12"
                                        Background="{ThemeResource DragonCrimsonSoftBrush}">
                                    <FontIcon Glyph="&#xE72E;" FontSize="18"
                                              Foreground="{ThemeResource DragonCrimsonBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Mount" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Native engine • milestone 0.2"
                                               Foreground="{ThemeResource DragonMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" x:Name="ResultCard" Visibility="Collapsed"
                            Margin="0,16,0,0"
                            Background="{ThemeResource DragonPanelStrongBrush}"
                            BorderBrush="{ThemeResource DragonBorderHotBrush}"
                            BorderThickness="1" CornerRadius="20" Padding="20">
                        <Grid x:Name="ResultGrid" ColumnSpacing="16" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="16"
                                    Background="{ThemeResource DragonEmberSoftBrush}">
                                <FontIcon Glyph="&#xEDA2;" FontSize="25"
                                          Foreground="{ThemeResource DragonEmberBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="IMAGE READY" FontSize="10" FontWeight="Bold"
                                           Foreground="{ThemeResource DragonEmberBrush}" CharacterSpacing="150" />
                                <TextBlock x:Name="ImageNameText" Text="image.iso"
                                           FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ImageMetaText" Text="ISO • 0 MB • Signature"
                                           Foreground="{ThemeResource DragonMutedBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ImagePathText" Text="C:\..."
                                           Foreground="{ThemeResource DragonMutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="ResultActions"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Content="Explore" IsEnabled="False"
                                        Style="{StaticResource DragonSecondaryButtonStyle}"
                                        ToolTipService.ToolTip="Dragon Explorer arrives in milestone 0.3" />
                                <Button x:Name="MountButton" Content="Mount" IsEnabled="False"
                                        Style="{StaticResource DragonSecondaryButtonStyle}"
                                        ToolTipService.ToolTip="Native mount service arrives in milestone 0.2" />
                                <Button Content="Verify" Click="Verify_Click"
                                        Style="{StaticResource DragonPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="2,18,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dragon DiskForge • Foundation channel"
                                   FontSize="11" Foreground="{ThemeResource DragonMutedBrush}" />
                        <TextBlock x:Name="SafeModeText"
                                   Grid.Column="1" Text="READ-ONLY SAFE MODE"
                                   FontSize="10" FontWeight="Bold" CharacterSpacing="120"
                                   Foreground="{ThemeResource DragonSuccessBrush}" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <Border x:Name="StartupOverlay"
                Grid.ZIndex="100"
                Background="{ThemeResource DragonBackgroundBrush}">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="18">
                    <Border Width="104" Height="104" CornerRadius="30"
                            Background="{StaticResource DragonEmberGradientBrush}"
                            HorizontalAlignment="Center">
                        <Viewbox Margin="21">
                            <Path Fill="White"
                                  Data="M 48,2 C 38,12 33,22 34,33 C 27,27 20,25 11,27 C 21,34 24,41 20,50 C 16,59 19,69 28,75 C 34,79 40,79 46,76 C 40,72 36,67 36,61 C 42,65 49,67 57,66 C 67,65 76,59 82,50 C 74,53 67,52 62,48 C 70,44 76,37 79,28 C 70,32 62,33 55,31 C 58,22 56,12 48,2 Z M 50,36 C 57,35 63,37 67,42 C 61,41 56,42 51,45 C 48,43 47,40 50,36 Z" />
                        </Viewbox>
                    </Border>
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <TextBlock Text="DRAGON DISKFORGE"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="25" FontWeight="Bold"
                                   CharacterSpacing="90"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="IGNITING THE FORGE"
                                   FontSize="10" FontWeight="Bold"
                                   CharacterSpacing="230"
                                   Foreground="{ThemeResource DragonEmberBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Width="210" Height="3" IsIndeterminate="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
