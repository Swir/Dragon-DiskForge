<UserControl
    x:Class="DragonDiskForge.App.Views.ExplorerWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent" Padding="22,20,22,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="8,0,8,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="DRAGON EXPLORER WORKSPACE" FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource DragonEmberBrush}" CharacterSpacing="200" />
                <TextBlock Text="Multi-image tabs"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{ThemeResource DragonTextBrush}" />
                <TextBlock Text="Each tab is an independent read-only session: live mounted volumes and supported direct providers can coexist. Closing a tab never unmounts an image."
                           Foreground="{ThemeResource DragonMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource DragonStatusPillStyle}" VerticalAlignment="Center">
                <TextBlock x:Name="TabCountText" Text="0 tabs" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <TabView x:Name="WorkspaceTabs"
                     Visibility="Collapsed"
                     IsAddTabButtonVisible="False"
                     TabWidthMode="SizeToContent"
                     TabCloseRequested="WorkspaceTabs_TabCloseRequested" />

            <Border x:Name="EmptyState"
                    Margin="8,0,8,0"
                    Background="{ThemeResource DragonPanelStrongBrush}"
                    BorderBrush="{ThemeResource DragonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="30"
                    MinHeight="300">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="70" Height="70" CornerRadius="20"
                            Background="{ThemeResource DragonEmberSoftBrush}">
                        <FontIcon Glyph="&#xE7C3;" FontSize="30"
                                  Foreground="{ThemeResource DragonMoltenBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No Explorer tabs open"
                               FontSize="21" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDescriptionText"
                               Text="Open a mounted ISO/VHD/VHDX from Mounted, or open a supported image directly from the Forge without mounting."
                               Foreground="{ThemeResource DragonMutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
