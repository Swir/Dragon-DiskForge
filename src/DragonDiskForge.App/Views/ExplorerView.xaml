<UserControl
    x:Class="DragonDiskForge.App.Views.ExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent" Padding="30,24,30,34" MaxWidth="1320" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="DRAGON EXPLORER" FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource DragonEmberBrush}" CharacterSpacing="220" />
                <TextBlock Text="Browse the mounted image"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="30" FontWeight="SemiBold"
                           Foreground="{ThemeResource DragonTextBrush}" />
                <TextBlock x:Name="RootDescriptionText"
                           Text="Choose a mounted ISO, VHD or VHDX to begin."
                           Foreground="{ThemeResource DragonMutedBrush}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False"
                              AutomationProperties.Name="Loading mounted volume" />
                <Button Content="Up" Click="Up_Click"
                        x:Name="UpButton" IsEnabled="False" AccessKey="U"
                        AutomationProperties.Name="Go up one folder"
                        AutomationProperties.HelpText="Moves to the parent folder in Dragon Explorer."
                        Style="{StaticResource DragonSecondaryButtonStyle}" />
                <Button Content="Refresh" Click="Refresh_Click"
                        x:Name="RefreshButton" IsEnabled="False" AccessKey="R"
                        AutomationProperties.Name="Refresh mounted volume"
                        AutomationProperties.HelpText="Reloads the current mounted-volume location."
                        Style="{StaticResource DragonSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{ThemeResource DragonPanelStrongBrush}"
                BorderBrush="{ThemeResource DragonBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="12"
                Margin="0,0,0,12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="&#xE838;" FontSize="16"
                          Foreground="{ThemeResource DragonEmberBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="AddressText" Grid.Column="1"
                           Text="No mounted volume selected"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource DragonTextBrush}"
                           AutomationProperties.Name="Current mounted path"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBox x:Name="SearchBox" Grid.Column="2"
                         PlaceholderText="Search this mounted volume"
                         IsEnabled="False"
                         AutomationProperties.Name="Search mounted volume"
                         AutomationProperties.HelpText="Enter part of a file or folder name and activate Search." />
                <Button Grid.Column="3" Content="Search" Click="Search_Click"
                        x:Name="SearchButton" IsEnabled="False" AccessKey="S"
                        AutomationProperties.Name="Search mounted volume"
                        Style="{StaticResource DragonSecondaryButtonStyle}" />
                <Button Grid.Column="4" Content="Clear" Click="ClearSearch_Click"
                        x:Name="ClearSearchButton" Visibility="Collapsed" AccessKey="L"
                        AutomationProperties.Name="Clear Explorer search"
                        Style="{StaticResource DragonSecondaryButtonStyle}" />
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar"
                 Grid.Row="2"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="0,0,0,12"
                 AutomationProperties.Name="Dragon Explorer status"
                 AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="ItemCountText" Text="0 items"
                           Foreground="{ThemeResource DragonMutedBrush}"
                           AutomationProperties.Name="Visible item count"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Tip: drag a safe file or folder directly to Windows Explorer to copy it out."
                           FontSize="11"
                           Foreground="{ThemeResource DragonMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenButton" Content="Open" Click="Open_Click"
                        IsEnabled="False" AccessKey="O"
                        AutomationProperties.Name="Open selected item"
                        AutomationProperties.HelpText="Opens the selected safe file or folder from the mounted volume."
                        Style="{StaticResource DragonSecondaryButtonStyle}" />
                <Button x:Name="CopyOutButton" Content="Copy out" Click="CopyOut_Click"
                        IsEnabled="False" AccessKey="C"
                        AutomationProperties.Name="Copy selected item out"
                        AutomationProperties.HelpText="Copies the selected file or folder out without modifying the mounted image."
                        Style="{StaticResource DragonPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="EmptyState"
                    Grid.Column="0"
                    Background="{ThemeResource DragonPanelStrongBrush}"
                    BorderBrush="{ThemeResource DragonBorderBrush}"
                    BorderThickness="1" CornerRadius="22" Padding="28"
                    MinHeight="240"
                    AutomationProperties.Name="Explorer empty state">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="64" Height="64" CornerRadius="19"
                            Background="{ThemeResource DragonEmberSoftBrush}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="27"
                                  Foreground="{ThemeResource DragonEmberBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyTitleText" Text="No mounted volume selected"
                               FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDescriptionText"
                               Text="Mount an ISO, VHD or VHDX and open it from the Mounted dashboard."
                               Foreground="{ThemeResource DragonMutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
                </StackPanel>
            </Border>

            <ListView x:Name="ExplorerList"
                      Grid.Column="0"
                      Visibility="Collapsed"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="ExplorerList_ItemClick"
                      SelectionChanged="ExplorerList_SelectionChanged"
                      Background="Transparent"
                      HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="Mounted volume files and folders"
                      AutomationProperties.HelpText="Use arrow keys to select an item and Enter or Space to activate it.">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,7" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource DragonPanelStrongBrush}"
                                BorderBrush="{ThemeResource DragonBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14"
                                CanDrag="True"
                                DragStarting="ExplorerItem_DragStarting"
                                ToolTipService.ToolTip="Drag to Windows Explorer to copy out"
                                AutomationProperties.Name="{Binding Name}"
                                AutomationProperties.HelpText="{Binding SecondaryText}">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12"
                                        Background="{ThemeResource DragonEmberSoftBrush}">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                              Foreground="{ThemeResource DragonMoltenBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SecondaryText}"
                                               Foreground="{ThemeResource DragonMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Meta}"
                                           Foreground="{ThemeResource DragonMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="PreviewPane"
                    Grid.Column="1"
                    Width="360"
                    Visibility="Collapsed"
                    Background="{ThemeResource DragonPanelStrongBrush}"
                    BorderBrush="{ThemeResource DragonBorderHotBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18"
                    AutomationProperties.Name="Selected item preview">
                <StackPanel Spacing="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold"
                                   CharacterSpacing="180" Foreground="{ThemeResource DragonEmberBrush}" />
                        <ProgressRing x:Name="PreviewBusyRing" Grid.Column="1"
                                      Width="18" Height="18" IsActive="False"
                                      AutomationProperties.Name="Loading preview" />
                    </Grid>

                    <TextBlock x:Name="PreviewNameText" Text="Select a file"
                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="PreviewKindText" Text="Read-only preview"
                               Foreground="{ThemeResource DragonMutedBrush}" TextWrapping="Wrap" />

                    <Border Height="1" Background="{ThemeResource DragonBorderBrush}" />

                    <StackPanel x:Name="PreviewPlaceholder" Spacing="9" MinHeight="220"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="34"
                                  Foreground="{ThemeResource DragonMutedBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Select a file to inspect it without changing the mounted image."
                                   Foreground="{ThemeResource DragonMutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Image x:Name="PreviewImage"
                           Visibility="Collapsed"
                           MaxHeight="340"
                           Stretch="Uniform"
                           AutomationProperties.Name="Image preview" />

                    <ScrollViewer x:Name="PreviewTextScroll"
                                  Visibility="Collapsed"
                                  MaxHeight="340"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Text preview">
                        <TextBlock x:Name="PreviewTextBlock"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="NoWrap"
                                   FontFamily="Consolas"
                                   FontSize="12" />
                    </ScrollViewer>

                    <StackPanel x:Name="PreviewMetadataPanel"
                                Visibility="Collapsed"
                                Spacing="8" MinHeight="170"
                                AutomationProperties.Name="File metadata preview">
                        <Border Width="58" Height="58" CornerRadius="16"
                                Background="{ThemeResource DragonEmberSoftBrush}"
                                HorizontalAlignment="Left">
                            <FontIcon x:Name="PreviewMetadataIcon" Glyph="&#xE7C3;" FontSize="24"
                                      Foreground="{ThemeResource DragonMoltenBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PreviewDescriptionText"
                                   Foreground="{ThemeResource DragonTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewModifiedText"
                                   Foreground="{ThemeResource DragonMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="PreviewTruncatedText"
                               Visibility="Collapsed"
                               Text="Preview truncated for safety/performance."
                               Foreground="{ThemeResource DragonEmberBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
